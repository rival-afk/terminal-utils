#!/usr/bin/env python3

# update - удалить указанный файл и открыть его заново в редакторе.
# Если файла нет — ищет похожие в той же директории.

import os
import shlex
import subprocess
import sys

# Не падать на консолях без Unicode (например, cp1251 в Windows)
try:
    sys.stdout.reconfigure(errors="replace")
    sys.stderr.reconfigure(errors="replace")
except AttributeError:
    pass


def editor_command(target: str) -> list:
    editor = os.environ.get("EDITOR")
    if editor:
        return shlex.split(editor, posix=(os.name != "nt")) + [target]
    return ["notepad" if os.name == "nt" else "nano", target]


def find_similar(directory: str, base: str) -> list:
    base = base.lower()
    try:
        names = os.listdir(directory)
    except OSError:
        return []
    matches = []
    for name in sorted(names):
        full = os.path.join(directory, name)
        if os.path.isfile(full) and base in name.lower():
            matches.append(full)
        if len(matches) >= 5:
            break
    return matches


def main() -> int:
    if len(sys.argv) < 2:
        print("Ошибка: укажите имя файла.")
        print("Пример: update index.html")
        return 1

    target = sys.argv[1]

    if os.path.exists(target):
        if os.path.isdir(target):
            print(f"Ошибка: '{target}' является директорией, а не файлом.")
            return 1
        os.remove(target)
        subprocess.run(editor_command(target))
        return 0

    directory = os.path.dirname(target) or "."
    base = os.path.basename(target)

    if not os.path.isdir(directory):
        print(f"Ошибка: директория '{directory}' не существует.")
        return 1

    similar = find_similar(directory, base)
    if similar:
        print(f"Файл '{target}' не найден.")
        print("Возможно, вы имели в виду:")
        for path in similar:
            print(f"  {path}")
        print("Проверьте написание пути к файлу.")
    else:
        print(f"Файл '{target}' не найден. Похожих файлов в '{directory}' нет.")
        print("Проверьте правильность пути.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
