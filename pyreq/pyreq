#!/usr/bin/env python3

# pyreq - generate requirements.txt from current pip list in venv

import os
import subprocess
import sys

# Не падать на консолях без Unicode (например, cp1251 в Windows)
try:
    sys.stdout.reconfigure(errors="replace")
    sys.stderr.reconfigure(errors="replace")
except AttributeError:
    pass


def venv_python() -> str:
    venv = os.environ.get("VIRTUAL_ENV")
    if venv:
        candidate = os.path.join(
            venv,
            "Scripts" if os.name == "nt" else "bin",
            "python.exe" if os.name == "nt" else "python",
        )
        if os.path.exists(candidate):
            return candidate
    return sys.executable


def main() -> int:
    if not os.environ.get("VIRTUAL_ENV"):
        print("Error: No virtual environment detected. Please activate venv first.")
        return 1

    output_file = os.path.join(os.getcwd(), "requirements.txt")

    result = subprocess.run(
        [venv_python(), "-m", "pip", "list", "--format=freeze"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print("❌ Failed to generate requirements.txt")
        print(result.stderr, file=sys.stderr)
        return 1

    lines = [line.replace("==", ">=", 1) for line in result.stdout.splitlines() if line.strip()]
    with open(output_file, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + ("\n" if lines else ""))

    print(f"✅ requirements.txt has been created in {os.getcwd()}")
    print(f"📦 Total packages: {len(lines)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
